{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "build-x86",
      "displayName": "Linux x86_64 (GCC)",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/toolchains/x86_64-linux-gnu.cmake"
    },
    {
      "name": "build-arm",
      "displayName": "Linux aarch64 (GCC cross)",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/toolchains/aarch64-linux-gnu.cmake"
    }
  ],
  "buildPresets": [
    {
      "name": "build-x86",
      "configurePreset": "build-x86"
    },
    {
      "name": "build-arm",
      "configurePreset": "build-arm"
    }
  ]
}
